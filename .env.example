# Entorno de ejecucion: development | production | test
NODE_ENV=development

# Puerto donde escucha Express (el contenedor publica este mismo puerto)
PORT=8080

# Conexion a MongoDB.
#   - Atlas:            mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/adoptme
#   - Mongo local:      mongodb://127.0.0.1:27017/adoptme
#   - Contenedor a host: mongodb://host.docker.internal:27017/adoptme
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/adoptme

# Clave para firmar los JWT. En produccion usar una cadena larga y aleatoria.
SECRET_KEY=cambiame-por-una-cadena-larga-y-aleatoria
