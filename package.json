{
  "name": "backend-3_coderhouse",
  "version": "1.0.0",
  "description": "Proyecto Final Backend III (Coderhouse) - API AdoptMe con tests funcionales, Docker y documentacion OpenAPI",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "mocha",
    "test:adoption": "mocha test/adoption.router.test.js",
    "test:coverage": "c8 mocha",
    "test:coverage:adoption": "c8 --include=src/routes/adoption.router.js --include=src/controllers/adoptions.controller.js --include=src/middlewares/validateObjectId.middleware.js --check-coverage --statements=100 --lines=100 --functions=100 --branches=85 mocha test/adoption.router.test.js"
  },
  "keywords": [
    "coderhouse",
    "backend",
    "express",
    "mongodb",
    "testing",
    "docker",
    "openapi"
  ],
  "author": "Thomas Munoz",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.5.0",
    "multer": "^2.0.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "chai": "^6.2.0",
    "mocha": "^11.7.4",
    "sinon": "^21.0.0",
    "supertest": "^7.2.2"
  }
}
